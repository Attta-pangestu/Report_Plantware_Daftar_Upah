      "locked": false
    },
    {
      "type": "text",
      "version": 17,
      "versionNonce": 302954029,
      "isDeleted": false,
      "id": "nGbygMkpiLxAWynzTu6S6",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 6352.251614164526,
      "y": 736.2107359046711,
      "strokeColor": "#f08c00",
      "backgroundColor": "#b2f2bb",
      "width": 771.8194580078125,
      "height": 1400,
      "seed": 2084214410,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1762237541114,
      "link": null,
      "locked": false,
      "fontSize": 20,
      "fontFamily": 5,
      "text": "-- Query aggregate: Sum transaksi per worker per tanggal, dengan dedup\nTRANSNO\nSELECT\n    a.WORKERID AS EMP_CODE,\n    e.NAME AS EMP_NAME,\n    a.TRANSDATE AS TRANSACTION_DATE,\n    -- Aggregate scanner (ambil yang paling representatif, misalnya MAX)\n    MAX(a.SCANUSERID) AS SCANNER_USER_ID,\n    MAX(f.NAME) AS SCANNER_USER_NAME,\n    MAX(a.RECORDTAG) AS SCANNER_ROLE,\n    -- Field & Division (ambil MAX jika multiple, asumsikan satu per worker/date)\n    MAX(b.FIELDNO) AS FIELD_NAME,\n    MAX(b.DIVID) AS DIVISION_ID,\n    MAX(c.DIVNAME) AS DIVISION_NAME,\n    -- Sum bunches (exclude UNRIPEBCH, ROTTENBCH, LOOSEFRUIT)\n    SUM(\n        (a.RIPEBCH + a.BLACKBCH + a.LONGSTALKBCH + a.RATDMGBCH + \n         a.OVERRIPEBCH + a.UNDERRIPEBCH + a.ABNORMALBCH)\n    ) AS TOTAL_BUNCHES_DAILY,\n    -- Detail bunches (sum masing-masing untuk breakdown)\n    SUM(a.RIPEBCH) AS SUM_RIPEBCH,\n    SUM(a.UNRIPEBCH) AS SUM_UNRIPEBCH,\n    SUM(a.BLACKBCH) AS SUM_BLACKBCH,\n    SUM(a.ROTTENBCH) AS SUM_ROTTENBCH,\n    SUM(a.LONGSTALKBCH) AS SUM_LONGSTALKBCH,\n    SUM(a.RATDMGBCH) AS SUM_RATDMGBCH,\n    SUM(a.LOOSEFRUIT) AS SUM_LOOSEFRUIT,\n    SUM(a.OVERRIPEBCH) AS SUM_OVERRIPEBCH,\n    SUM(a.UNDERRIPEBCH) AS SUM_UNDERRIPEBCH,\n    SUM(a.ABNORMALBCH) AS SUM_ABNORMALBCH,\n    SUM(a.LOOSEFRUIT2) AS SUM_LOOSEFRUIT2,\n    -- Lainnya\n    COUNT(DISTINCT a.TRANSNO) AS TRANSACTION_COUNT,\n    MAX(a.TRANSTIME) AS LATEST_TRANSACTION_TIME,  -- Waktu\nterakhir\n    MAX(a.TRANSSTATUS) AS STATUS,\n    MAX(a.UPLOADDATETIME) AS LATEST_UPLOAD_DATETIME\nFROM FFBSCANNERDATA10 a\nLEFT JOIN OCFIELD b ON a.FIELDID = b.ID\nLEFT JOIN CRDIVISION c ON b.DIVID = c.ID\nLEFT JOIN EMP e ON a.WORKERID = e.ID\nLEFT JOIN EMP f ON a.SCANUSERID = f.ID\nWHERE a.TRANSDATE = '2025-10-01'  -- Ganti dengan tanggal lain jika perlu\n    AND a.WORKERID IS NOT NULL\n    AND a.ID = (  -- Dedup: Ambil ID terkecil per TRANSNO unik\n        SELECT FIRST 1 x.ID\n        FROM FFBSCANNERDATA10 x\n        WHERE x.TRANSNO = a.TRANSNO\n            AND x.TRANSDATE = a.TRANSDATE  -- Sesuaikan dengan tanggal\nfilter\n            AND x.WORKERID IS NOT NULL\n        ORDER BY x.SCANUSERID, x.ID\n    )\nGROUP BY a.WORKERID, e.NAME, a.TRANSDATE  -- Grup utama: per worker\nper tanggal\nORDER BY a.TRANSDATE, a.WORKERID;  -- Urut tanggal lalu worker",
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "BrZ0xbVu-Gm8tEweDhXts",
      "originalText": "-- Query aggregate: Sum transaksi per worker per tanggal, dengan dedup TRANSNO\nSELECT\n    a.WORKERID AS EMP_CODE,\n    e.NAME AS EMP_NAME,\n    a.TRANSDATE AS TRANSACTION_DATE,\n    -- Aggregate scanner (ambil yang paling representatif, misalnya MAX)\n    MAX(a.SCANUSERID) AS SCANNER_USER_ID,\n    MAX(f.NAME) AS SCANNER_USER_NAME,\n    MAX(a.RECORDTAG) AS SCANNER_ROLE,\n    -- Field & Division (ambil MAX jika multiple, asumsikan satu per worker/date)\n    MAX(b.FIELDNO) AS FIELD_NAME,\n    MAX(b.DIVID) AS DIVISION_ID,\n    MAX(c.DIVNAME) AS DIVISION_NAME,\n    -- Sum bunches (exclude UNRIPEBCH, ROTTENBCH, LOOSEFRUIT)\n    SUM(\n        (a.RIPEBCH + a.BLACKBCH + a.LONGSTALKBCH + a.RATDMGBCH + \n         a.OVERRIPEBCH + a.UNDERRIPEBCH + a.ABNORMALBCH)\n    ) AS TOTAL_BUNCHES_DAILY,\n    -- Detail bunches (sum masing-masing untuk breakdown)\n    SUM(a.RIPEBCH) AS SUM_RIPEBCH,\n    SUM(a.UNRIPEBCH) AS SUM_UNRIPEBCH,\n    SUM(a.BLACKBCH) AS SUM_BLACKBCH,\n    SUM(a.ROTTENBCH) AS SUM_ROTTENBCH,\n    SUM(a.LONGSTALKBCH) AS SUM_LONGSTALKBCH,\n    SUM(a.RATDMGBCH) AS SUM_RATDMGBCH,\n    SUM(a.LOOSEFRUIT) AS SUM_LOOSEFRUIT,\n    SUM(a.OVERRIPEBCH) AS SUM_OVERRIPEBCH,\n    SUM(a.UNDERRIPEBCH) AS SUM_UNDERRIPEBCH,\n    SUM(a.ABNORMALBCH) AS SUM_ABNORMALBCH,\n    SUM(a.LOOSEFRUIT2) AS SUM_LOOSEFRUIT2,\n    -- Lainnya\n    COUNT(DISTINCT a.TRANSNO) AS TRANSACTION_COUNT,\n    MAX(a.TRANSTIME) AS LATEST_TRANSACTION_TIME,  -- Waktu terakhir\n    MAX(a.TRANSSTATUS) AS STATUS,\n    MAX(a.UPLOADDATETIME) AS LATEST_UPLOAD_DATETIME\nFROM FFBSCANNERDATA10 a\nLEFT JOIN OCFIELD b ON a.FIELDID = b.ID\nLEFT JOIN CRDIVISION c ON b.DIVID = c.ID\nLEFT JOIN EMP e ON a.WORKERID = e.ID\nLEFT JOIN EMP f ON a.SCANUSERID = f.ID\nWHERE a.TRANSDATE = '2025-10-01'  -- Ganti dengan tanggal lain jika perlu\n    AND a.WORKERID IS NOT NULL\n    AND a.ID = (  -- Dedup: Ambil ID terkecil per TRANSNO unik\n        SELECT FIRST 1 x.ID\n        FROM FFBSCANNERDATA10 x\n        WHERE x.TRANSNO = a.TRANSNO\n            AND x.TRANSDATE = a.TRANSDATE  -- Sesuaikan dengan tanggal filter\n            AND x.WORKERID IS NOT NULL\n        ORDER BY x.SCANUSERID, x.ID\n    )\nGROUP BY a.WORKERID, e.NAME, a.TRANSDATE  -- Grup utama: per worker per tanggal\nORDER BY a.TRANSDATE, a.WORKERID;  -- Urut tanggal lalu worker",
      "lineHeight": 1.25,
      "baseline": 1396
    },
    {
      "type": "rectangle",
      "version": 385,
      "versionNonce": 222740675,
      "isDeleted": false,
      "id": "24eW5VxGr3D08fHUWBL_9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 7249.665068114099,
      "y": 792.7953286185193,
      "strokeColor": "#1971c2",
