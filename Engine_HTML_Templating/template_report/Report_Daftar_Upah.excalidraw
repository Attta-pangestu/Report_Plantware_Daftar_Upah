    {
      "type": "text",
      "version": 67,
      "versionNonce": 1955686541,
      "isDeleted": false,
      "id": "8sl8sZZLnqt6sCejBnrZ4",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 7254.665068114099,
      "y": 797.7953286185193,
      "strokeColor": "#f08c00",
      "backgroundColor": "#b2f2bb",
      "width": 748.57958984375,
      "height": 1525,
      "seed": 1043820298,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1762237541114,
      "link": null,
      "locked": false,
      "fontSize": 20,
      "fontFamily": 5,
      "text": "-- Query untuk mendapatkan ringkasan transaksi harian untuk EMP Code\ntertentu pada tanggal 1 Oktober 2025\n-- Menampilkan total bunches per tanggal untuk karyawan tertentu\n-- Dengan penanganan duplikat TRANSNO untuk menghindari double counting\n-- Hasilnya adalah 1 baris per tanggal per karyawan EMP Code tertentu\n-- Versi kompatibel untuk Firebird 1.5\n\nSELECT \n    a.WORKERID as EMP_CODE,                 -- WORKERID digunakan\nsebagai EmpCode\n    e.EMPCODE as EMP_EMPCODE,               -- EmpCode dari tabel EMP\n    e.NAME as EMP_NAME,                     -- Nama karyawan dari tabel EMP\n    a.TRANSDATE as TRANSACTION_DATE,        -- Tanggal transaksi\n    COUNT(a.TRANSNO) as TOTAL_TRANSACTIONS, -- Jumlah total\ntransaksi oleh karyawan pada tanggal tersebut\n    SUM(a.RIPEBCH) as TOTAL_RIPE_BUNCHES,\n    SUM(a.UNRIPEBCH) as TOTAL_UNRIPE_BUNCHES,\n    SUM(a.BLACKBCH) as TOTAL_BLACK_BUNCHES,\n    SUM(a.ROTTENBCH) as TOTAL_ROTTEN_BUNCHES,\n    SUM(a.LONGSTALKBCH) as TOTAL_LONG_STALK_BUNCHES,\n    SUM(a.RATDMGBCH) as TOTAL_RAT_DAMAGE_BUNCHES,\n    SUM(a.LOOSEFRUIT) as TOTAL_LOOSE_FRUIT,\n    SUM(a.OVERRIPEBCH) as TOTAL_OVER_RIPE_BUNCHES,\n    SUM(a.UNDERRIPEBCH) as TOTAL_UNDER_RIPE_BUNCHES,\n    SUM(a.ABNORMALBCH) as TOTAL_ABNORMAL_BUNCHES,\n    SUM(a.LOOSEFRUIT2) as TOTAL_LOOSE_FRUIT2,\n    SUM(a.RIPEBCH + a.BLACKBCH + a.LONGSTALKBCH + a.RATDMGBCH +\na.OVERRIPEBCH + a.UNDERRIPEBCH + a.ABNORMALBCH) as\nTOTAL_BUNCHES_NET,\n    SUM(CASE WHEN a.TRANSSTATUS = 704 THEN 1 ELSE 0 END) as\nTRANSACTIONS_STATUS_704,\n    MIN(a.TRANSTIME) as FIRST_TRANSACTION_TIME,  -- Waktu\ntransaksi pertama\n    MAX(a.TRANSTIME) as LAST_TRANSACTION_TIME    -- Waktu\ntransaksi terakhir\nFROM FFBSCANNERDATA10 a\nLEFT JOIN OCFIELD b ON a.FIELDID = b.ID    -- Join berdasarkan ID\nLEFT JOIN CRDIVISION c ON b.DIVID = c.ID   -- Join berdasarkan DIVID\nLEFT JOIN EMP e ON a.WORKERID = e.ID       -- Join ke tabel EMP untuk\nmendapatkan informasi karyawan\nLEFT JOIN EMP f ON a.SCANUSERID = f.ID     -- Join ke tabel EMP untuk\nmendapatkan nama scanner user\nWHERE a.TRANSDATE = '2025-10-01'\n    AND a.WORKERID IS NOT NULL\n    AND e.EMPCODE = 'D0043'  -- Filter untuk EMP Code tertentu\n(JANUAR/MARYATI)\n    AND a.ID = (\n        -- Subquery untuk mendapatkan ID terkecil (pertama) untuk setiap\nkombinasi TRANSNO dan WORKERID\n        -- Ini menangani duplicate TRANSNO dengan hanya mengambil satu per\nTRANSNO unik per WORKER\n        SELECT FIRST 1 x.ID\n        FROM FFBSCANNERDATA10 x\n        WHERE x.TRANSNO = a.TRANSNO\n            AND x.WORKERID = a.WORKERID\n            AND x.TRANSDATE = '2025-10-01'\n            AND x.WORKERID IS NOT NULL\n        ORDER BY x.SCANUSERID, x.ID\n    )\nGROUP BY a.WORKERID, a.TRANSDATE, e.EMPCODE, e.NAME\nORDER BY a.TRANSDATE;",
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "24eW5VxGr3D08fHUWBL_9",
      "originalText": "-- Query untuk mendapatkan ringkasan transaksi harian untuk EMP Code tertentu pada tanggal 1 Oktober 2025\n-- Menampilkan total bunches per tanggal untuk karyawan tertentu\n-- Dengan penanganan duplikat TRANSNO untuk menghindari double counting\n-- Hasilnya adalah 1 baris per tanggal per karyawan EMP Code tertentu\n-- Versi kompatibel untuk Firebird 1.5\n\nSELECT \n    a.WORKERID as EMP_CODE,                 -- WORKERID digunakan sebagai EmpCode\n    e.EMPCODE as EMP_EMPCODE,               -- EmpCode dari tabel EMP\n    e.NAME as EMP_NAME,                     -- Nama karyawan dari tabel EMP\n    a.TRANSDATE as TRANSACTION_DATE,        -- Tanggal transaksi\n    COUNT(a.TRANSNO) as TOTAL_TRANSACTIONS, -- Jumlah total transaksi oleh karyawan pada tanggal tersebut\n    SUM(a.RIPEBCH) as TOTAL_RIPE_BUNCHES,\n    SUM(a.UNRIPEBCH) as TOTAL_UNRIPE_BUNCHES,\n    SUM(a.BLACKBCH) as TOTAL_BLACK_BUNCHES,\n    SUM(a.ROTTENBCH) as TOTAL_ROTTEN_BUNCHES,\n    SUM(a.LONGSTALKBCH) as TOTAL_LONG_STALK_BUNCHES,\n    SUM(a.RATDMGBCH) as TOTAL_RAT_DAMAGE_BUNCHES,\n    SUM(a.LOOSEFRUIT) as TOTAL_LOOSE_FRUIT,\n    SUM(a.OVERRIPEBCH) as TOTAL_OVER_RIPE_BUNCHES,\n    SUM(a.UNDERRIPEBCH) as TOTAL_UNDER_RIPE_BUNCHES,\n    SUM(a.ABNORMALBCH) as TOTAL_ABNORMAL_BUNCHES,\n    SUM(a.LOOSEFRUIT2) as TOTAL_LOOSE_FRUIT2,\n    SUM(a.RIPEBCH + a.BLACKBCH + a.LONGSTALKBCH + a.RATDMGBCH + a.OVERRIPEBCH + a.UNDERRIPEBCH + a.ABNORMALBCH) as TOTAL_BUNCHES_NET,\n    SUM(CASE WHEN a.TRANSSTATUS = 704 THEN 1 ELSE 0 END) as TRANSACTIONS_STATUS_704,\n    MIN(a.TRANSTIME) as FIRST_TRANSACTION_TIME,  -- Waktu transaksi pertama\n    MAX(a.TRANSTIME) as LAST_TRANSACTION_TIME    -- Waktu transaksi terakhir\nFROM FFBSCANNERDATA10 a\nLEFT JOIN OCFIELD b ON a.FIELDID = b.ID    -- Join berdasarkan ID\nLEFT JOIN CRDIVISION c ON b.DIVID = c.ID   -- Join berdasarkan DIVID\nLEFT JOIN EMP e ON a.WORKERID = e.ID       -- Join ke tabel EMP untuk mendapatkan informasi karyawan\nLEFT JOIN EMP f ON a.SCANUSERID = f.ID     -- Join ke tabel EMP untuk mendapatkan nama scanner user\nWHERE a.TRANSDATE = '2025-10-01'\n    AND a.WORKERID IS NOT NULL\n    AND e.EMPCODE = 'D0043'  -- Filter untuk EMP Code tertentu (JANUAR/MARYATI)\n    AND a.ID = (\n        -- Subquery untuk mendapatkan ID terkecil (pertama) untuk setiap kombinasi TRANSNO dan WORKERID\n        -- Ini menangani duplicate TRANSNO dengan hanya mengambil satu per TRANSNO unik per WORKER\n        SELECT FIRST 1 x.ID\n        FROM FFBSCANNERDATA10 x\n        WHERE x.TRANSNO = a.TRANSNO\n            AND x.WORKERID = a.WORKERID\n            AND x.TRANSDATE = '2025-10-01'\n            AND x.WORKERID IS NOT NULL\n        ORDER BY x.SCANUSERID, x.ID\n    )\nGROUP BY a.WORKERID, a.TRANSDATE, e.EMPCODE, e.NAME\nORDER BY a.TRANSDATE;",
      "lineHeight": 1.25,
      "baseline": 1521
    },
