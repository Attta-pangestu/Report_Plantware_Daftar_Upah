      "locked": false,
      "fontSize": 14,
      "fontFamily": 1,
      "text": "-- Query untuk mengelompokkan data berdasarkan DIV ID \n-- Menggunakan tabel FFBSCANNERDATA05 (Mei) sebagai contoh\n\nSELECT \n    b.DIVID as DIV_ID,\n    c.DIVNAME as DIV_NAME,\n    COUNT(*) as TOTAL_TRANSAKSI,\n    COUNT(DISTINCT a.TRANSNO) as TOTAL_TRANSNO_UNIK,\n    COUNT(CASE WHEN a.RECORDTAG = 'PM' THEN 1 END) as KERANI_COUNT,\n    COUNT(CASE WHEN a.RECORDTAG = 'P1' THEN 1 END) as ASISTEN_COUNT,\n    COUNT(CASE WHEN a.RECORDTAG = 'P5' THEN 1 END) as MANDOR_COUNT,\n    SUM(a.RIPEBCH) as TOTAL_RIPEBCH,\n    SUM(a.UNRIPEBCH) as TOTAL_UNRIPEBCH,\n    SUM(a.BLACKBCH) as TOTAL_BLACKBCH,\n    SUM(a.ROTTENBCH) as TOTAL_ROTTENBCH,\n    AVG(a.RIPEBCH) as AVG_RIPEBCH,\n    AVG(a.UNRIPEBCH) as AVG_UNRIPEBCH,\n    AVG(a.BLACKBCH) as AVG_BLACKBCH,\n    AVG(a.ROTTENBCH) as AVG_ROTTENBCH\nFROM FFBSCANNERDATA05 a\nJOIN OCFIELD b ON a.FIELDID = b.ID\nLEFT JOIN CRDIVISION c ON b.DIVID = c.ID\nWHERE b.DIVID IS NOT NULL \n    AND c.DIVNAME IS NOT NULL\nGROUP BY b.DIVID, c.DIVNAME\nORDER BY b.DIVID;",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "RC1pVDfj-YltLcKcL_N4o",
      "originalText": "-- Query untuk mengelompokkan data berdasarkan DIV ID \n-- Menggunakan tabel FFBSCANNERDATA05 (Mei) sebagai contoh\n\nSELECT \n    b.DIVID as DIV_ID,\n    c.DIVNAME as DIV_NAME,\n    COUNT(*) as TOTAL_TRANSAKSI,\n    COUNT(DISTINCT a.TRANSNO) as TOTAL_TRANSNO_UNIK,\n    COUNT(CASE WHEN a.RECORDTAG = 'PM' THEN 1 END) as KERANI_COUNT,\n    COUNT(CASE WHEN a.RECORDTAG = 'P1' THEN 1 END) as ASISTEN_COUNT,\n    COUNT(CASE WHEN a.RECORDTAG = 'P5' THEN 1 END) as MANDOR_COUNT,\n    SUM(a.RIPEBCH) as TOTAL_RIPEBCH,\n    SUM(a.UNRIPEBCH) as TOTAL_UNRIPEBCH,\n    SUM(a.BLACKBCH) as TOTAL_BLACKBCH,\n    SUM(a.ROTTENBCH) as TOTAL_ROTTENBCH,\n    AVG(a.RIPEBCH) as AVG_RIPEBCH,\n    AVG(a.UNRIPEBCH) as AVG_UNRIPEBCH,\n    AVG(a.BLACKBCH) as AVG_BLACKBCH,\n    AVG(a.ROTTENBCH) as AVG_ROTTENBCH\nFROM FFBSCANNERDATA05 a\nJOIN OCFIELD b ON a.FIELDID = b.ID\nLEFT JOIN CRDIVISION c ON b.DIVID = c.ID\nWHERE b.DIVID IS NOT NULL \n    AND c.DIVNAME IS NOT NULL\nGROUP BY b.DIVID, c.DIVNAME\nORDER BY b.DIVID;",
      "lineHeight": 1.25,
      "baseline": 452
    },
