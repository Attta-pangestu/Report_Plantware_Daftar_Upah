      "fontFamily": 1,
      "text": "SELECT TOP 100\n       t.*,\n       ln.Amount\nFROM   PR_ADTRANS_ARC      AS t\nJOIN   PR_ADTRANSLN_ARC    AS ln\n       ON t.ID = ln.MasterID\nWHERE  t.EmpCode = 'H0033'\n  AND  t.DocDate >= '2025-05-01'\n  AND  t.DocDate <  '2025-06-01';\n",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "lJLjHB0nFvnquOzbXzctf",
      "originalText": "SELECT TOP 100\n       t.*,\n       ln.Amount\nFROM   PR_ADTRANS_ARC      AS t\nJOIN   PR_ADTRANSLN_ARC    AS ln\n       ON t.ID = ln.MasterID\nWHERE  t.EmpCode = 'H0033'\n  AND  t.DocDate >= '2025-05-01'\n  AND  t.DocDate <  '2025-06-01';\n",
