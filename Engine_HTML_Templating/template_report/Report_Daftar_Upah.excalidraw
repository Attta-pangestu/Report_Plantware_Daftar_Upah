    {
      "type": "text",
      "version": 412,
      "versionNonce": 864892877,
      "isDeleted": false,
      "id": "QNRv45D5eyeH4nXwElDbT",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 5393.702750231763,
      "y": 710.44077438139,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "width": 773.1774291992188,
      "height": 1015,
      "seed": 1405355414,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1762237541114,
      "link": null,
      "locked": false,
      "fontSize": 14,
      "fontFamily": 1,
      "text": "-- Query untuk mendapatkan transaksi per lapangan (field) berdasarkan WorkerID pada tanggal 1 Oktober\n2025\n-- Menampilkan juga nama karyawan (Name) dan EmpCode dari tabel EMP\n-- Juga menampilkan informasi scanner user (siapa yang melakukan scan)\n-- Juga menampilkan tanggal transaksi\n-- Menangani duplicate TRANSNO dengan hanya menampilkan satu per TRANSNO unik (menggunakan pendekatan\nFirebird 1.5)\n-- Total bunches tidak termasuk UNRIPEBCH, ROTTENBCH, dan LOOSEFRUIT\n-- Menggunakan nama kolom yang benar berdasarkan struktur database\n\nSELECT \n    a.WORKERID as EMP_CODE,                 -- WORKERID digunakan sebagai EmpCode\n    e.NAME as EMP_NAME,                     -- Nama karyawan dari tabel EMP\n    a.SCANUSERID as SCANNER_USER_ID,        -- ID scanner user\n    f.NAME as SCANNER_USER_NAME,            -- Nama scanner user dari tabel EMP\n    a.RECORDTAG as SCANNER_ROLE,            -- Peran scanner (PM, P1, P5, dll)\n    a.TRANSDATE as TRANSACTION_DATE,        -- Tanggal transaksi\n    a.TRANSTIME as TRANSACTION_TIME,        -- Waktu transaksi\n    a.TRANSNO,                              -- Nomor transaksi\n    a.CARRIERID,\n    b.FIELDNO as FIELD_NAME,                -- Menggunakan FIELDNO karena kolom NAME tidak ada di\nOCFIELD\n    b.DIVID as DIVISION_ID,\n    c.DIVNAME as DIVISION_NAME,\n    a.RIPEBCH,\n    a.UNRIPEBCH,\n    a.BLACKBCH,\n    a.ROTTENBCH,\n    a.LONGSTALKBCH,\n    a.RATDMGBCH,\n    a.LOOSEFRUIT,\n    a.OVERRIPEBCH,\n    a.UNDERRIPEBCH,\n    a.ABNORMALBCH,\n    a.LOOSEFRUIT2,\n    (a.RIPEBCH + a.BLACKBCH + a.LONGSTALKBCH + a.RATDMGBCH + a.OVERRIPEBCH + a.UNDERRIPEBCH\n+ a.ABNORMALBCH) as TOTAL_BUNCHES,\n    a.TRANSSTATUS,\n    a.UPLOADDATETIME\nFROM FFBSCANNERDATA10 a\nLEFT JOIN OCFIELD b ON a.FIELDID = b.ID    -- Join berdasarkan ID\nLEFT JOIN CRDIVISION c ON b.DIVID = c.ID   -- Join berdasarkan DIVID\nLEFT JOIN EMP e ON a.WORKERID = e.ID       -- Join ke tabel EMP untuk mendapatkan nama karyawan\nLEFT JOIN EMP f ON a.SCANUSERID = f.ID     -- Join ke tabel EMP untuk mendapatkan nama scanner\nuser\nWHERE a.TRANSDATE = '2025-10-01'\n    AND a.WORKERID IS NOT NULL\n    AND a.ID = (\n        -- Subquery untuk mendapatkan ID terkecil (pertama) untuk setiap TRANSNO\n        -- Ini menangani duplicate TRANSNO dengan hanya mengambil satu per TRANSNO\n        SELECT FIRST 1 x.ID\n        FROM FFBSCANNERDATA10 x\n        WHERE x.TRANSNO = a.TRANSNO\n            AND x.TRANSDATE = '2025-10-01'\n            AND x.WORKERID IS NOT NULL\n        ORDER BY x.SCANUSERID, x.ID\n    )\nORDER BY b.DIVID, a.WORKERID, b.FIELDNO;",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "LMNPJvSRCRnr4vGaSo2UW",
      "originalText": "-- Query untuk mendapatkan transaksi per lapangan (field) berdasarkan WorkerID pada tanggal 1 Oktober 2025\n-- Menampilkan juga nama karyawan (Name) dan EmpCode dari tabel EMP\n-- Juga menampilkan informasi scanner user (siapa yang melakukan scan)\n-- Juga menampilkan tanggal transaksi\n-- Menangani duplicate TRANSNO dengan hanya menampilkan satu per TRANSNO unik (menggunakan pendekatan Firebird 1.5)\n-- Total bunches tidak termasuk UNRIPEBCH, ROTTENBCH, dan LOOSEFRUIT\n-- Menggunakan nama kolom yang benar berdasarkan struktur database\n\nSELECT \n    a.WORKERID as EMP_CODE,                 -- WORKERID digunakan sebagai EmpCode\n    e.NAME as EMP_NAME,                     -- Nama karyawan dari tabel EMP\n    a.SCANUSERID as SCANNER_USER_ID,        -- ID scanner user\n    f.NAME as SCANNER_USER_NAME,            -- Nama scanner user dari tabel EMP\n    a.RECORDTAG as SCANNER_ROLE,            -- Peran scanner (PM, P1, P5, dll)\n    a.TRANSDATE as TRANSACTION_DATE,        -- Tanggal transaksi\n    a.TRANSTIME as TRANSACTION_TIME,        -- Waktu transaksi\n    a.TRANSNO,                              -- Nomor transaksi\n    a.CARRIERID,\n    b.FIELDNO as FIELD_NAME,                -- Menggunakan FIELDNO karena kolom NAME tidak ada di OCFIELD\n    b.DIVID as DIVISION_ID,\n    c.DIVNAME as DIVISION_NAME,\n    a.RIPEBCH,\n    a.UNRIPEBCH,\n    a.BLACKBCH,\n    a.ROTTENBCH,\n    a.LONGSTALKBCH,\n    a.RATDMGBCH,\n    a.LOOSEFRUIT,\n    a.OVERRIPEBCH,\n    a.UNDERRIPEBCH,\n    a.ABNORMALBCH,\n    a.LOOSEFRUIT2,\n    (a.RIPEBCH + a.BLACKBCH + a.LONGSTALKBCH + a.RATDMGBCH + a.OVERRIPEBCH + a.UNDERRIPEBCH + a.ABNORMALBCH) as TOTAL_BUNCHES,\n    a.TRANSSTATUS,\n    a.UPLOADDATETIME\nFROM FFBSCANNERDATA10 a\nLEFT JOIN OCFIELD b ON a.FIELDID = b.ID    -- Join berdasarkan ID\nLEFT JOIN CRDIVISION c ON b.DIVID = c.ID   -- Join berdasarkan DIVID\nLEFT JOIN EMP e ON a.WORKERID = e.ID       -- Join ke tabel EMP untuk mendapatkan nama karyawan\nLEFT JOIN EMP f ON a.SCANUSERID = f.ID     -- Join ke tabel EMP untuk mendapatkan nama scanner user\nWHERE a.TRANSDATE = '2025-10-01'\n    AND a.WORKERID IS NOT NULL\n    AND a.ID = (\n        -- Subquery untuk mendapatkan ID terkecil (pertama) untuk setiap TRANSNO\n        -- Ini menangani duplicate TRANSNO dengan hanya mengambil satu per TRANSNO\n        SELECT FIRST 1 x.ID\n        FROM FFBSCANNERDATA10 x\n        WHERE x.TRANSNO = a.TRANSNO\n            AND x.TRANSDATE = '2025-10-01'\n            AND x.WORKERID IS NOT NULL\n        ORDER BY x.SCANUSERID, x.ID\n    )\nORDER BY b.DIVID, a.WORKERID, b.FIELDNO;",
      "lineHeight": 1.25,
      "baseline": 1012
    },
    {
      "type": "rectangle",
      "version": 334,
      "versionNonce": 57171235,
      "isDeleted": false,
      "id": "BrZ0xbVu-Gm8tEweDhXts",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 6347.251614164526,
      "y": 731.2107359046711,
      "strokeColor": "#1971c2",
      "backgroundColor": "#b2f2bb",
      "width": 783.5511755067334,
      "height": 1410,
      "seed": 2124799754,
